# CodeGraph: índice local por máquina (SQLite en .codegraph/)
.codegraph/

# Secretos y env local
.env
.secrets/
.env.*
!.env.sample
!.env.poc.sample
.env.poc
web/js/config.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
backend/.venv/
.cursor/.venv-mcp/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
build/
*.log

# Logs de aplicación (API / IA) — no versionar
web/logs/*
!web/logs/.gitkeep

# Ledger de viaje agentic (JSONL + MD)
data/journey/*
!data/journey/.gitkeep

# Copias de seguridad locales (generadas por scripts/poc-backup-local.ps1)
data/backups/*
!data/backups/.gitkeep

# Supabase CLI (estado local; versionar config.toml + migrations/)
supabase/.branches/
supabase/.temp/
supabase/.env

# Playwright / artefactos temporales POC
tmp/
tmp/playwright-output/
.playwright-mcp/
test-results/
playwright-report/
web/e2e/.auth/

# Media subida (mantener .gitkeep)
web/media/**/*
!web/media/**/.gitkeep
web/media/.tokens/

# PHP
api/vendor/
api/.phpunit.cache/
