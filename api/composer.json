{
  "name": "kuiperbelt/kidepik-api",
  "description": "KidepiK POC API (PHP)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Kidepik\\Api\\": "src/",
      "Kidepik\\Shared\\": "../shared/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kidepik\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
