# Copiar a kidepik/.env.poc
# docker compose --env-file .env.poc -f docker/compose.yaml up -d

APP_ENV=local
APP_NAME=kidepik-api

# Supabase local — desde el host; PHP en Docker usa host.docker.internal
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Postgres directo (supabase status → DB URL; puerto 54322 por defecto)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# URLs publicadas al cliente web (navegador en el PC)
PUBLIC_API_URL=/api/v1
PUBLIC_SUPABASE_URL=http://localhost:54321

# Media local bajo web/media/ (STORAGE_DRIVER=local)
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=/media
UPLOAD_TOKEN_TTL=900

# Tras `supabase start`, actualizar SUPABASE_ANON_KEY:
# supabase status -o env

# Playwright / agentes (solo local; ver SPEC_DEV_LOCAL_AUTH_PLAYWRIGHT.md)
# E2E_TUTOR_EMAIL=playwright-tutor@kidepik.local
# E2E_TUTOR_PASSWORD=playwright-local-dev

# IA / OpenRouter (solo servidor; ver SPEC_AI_OPENROUTER_GATEWAY.md)
# Preferible: copiar valores desde .secrets/openrouter.env (nunca versionar la clave).
# AI_ENABLED=true
# AI_PROVIDERS=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free
# AI_HTTP_REFERER=http://localhost:8082
# AI_APP_TITLE=KidepiK Local
# AI_MAX_TOKENS_PER_TURN=1024
# AI_RATE_LIMIT_PER_CHILD_DAY=80
# AI_MOCK=false
# En tests / Playwright sin cuota: AI_MOCK=true (respuesta determinista sin llamar red)

# Migraciones en local:
# - Supabase CLI: poc-up.ps1 ejecuta db reset / migration up
# - Contenedor PHP: entrypoint aplica pendientes al arrancar (RUN_MIGRATIONS_ON_START, default en local)
# - Por request: desactivado en APP_ENV=local (Config::runMigrationsOnRequest). Producción: activo con caché filesystem.
# RUN_MIGRATIONS_ON_REQUEST=true
# RUN_MIGRATIONS_ON_START=false
