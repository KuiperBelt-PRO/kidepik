# Copiar a kidepik/.env.poc y ajustar si usas dispositivo físico (IP LAN).
# docker compose --env-file ../.env.poc -f compose.yaml up -d

# Supabase local (host) — API accesible desde contenedor api vía host.docker.internal
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# URLs publicadas a la app móvil (emulador Android)
PUBLIC_API_URL=http://10.0.2.2:8080
PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
PUBLIC_STORAGE_URL=http://10.0.2.2:9000
S3_PUBLIC_BASE_URL=http://10.0.2.2:9000/kidepik-media
S3_EXTERNAL_ENDPOINT_URL=http://10.0.2.2:9000

# MinIO (simula Cloudflare R2)
S3_ACCESS_KEY_ID=kidepik
S3_SECRET_ACCESS_KEY=kidepik-local-secret
S3_BUCKET=kidepik-media

# Tras `supabase start`, copiar anon key a mobile/.env (EXPO_PUBLIC_SUPABASE_ANON_KEY)
# supabase status -o env
