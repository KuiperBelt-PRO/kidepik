# Copiar a kidepik/.env.poc
# docker compose --env-file .env.poc -f docker/compose.yaml up -d

APP_ENV=local
APP_NAME=kidepik-api

# Supabase local — desde el host; PHP en Docker usa host.docker.internal
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Postgres directo (supabase status → DB URL; puerto 54322 por defecto)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# URLs publicadas al cliente web (navegador en el PC)
PUBLIC_API_URL=/api/v1
PUBLIC_SUPABASE_URL=http://localhost:54321

# Media local bajo web/media/ (STORAGE_DRIVER=local)
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=/media
UPLOAD_TOKEN_TTL=900

# Tras `supabase start`, actualizar SUPABASE_ANON_KEY:
# supabase status -o env

# Playwright / agentes (solo local; ver SPEC_DEV_LOCAL_AUTH_PLAYWRIGHT.md)
# E2E_TUTOR_EMAIL=playwright-tutor@kidepik.local
# E2E_TUTOR_PASSWORD=playwright-local-dev

# IA / OpenRouter (legado PHP play — solo servidor)
# Preferible: copiar valores desde .secrets/openrouter.env (nunca versionar la clave).
# AI_ENABLED=true
# AI_PROVIDERS=openrouter
# OPENROUTER_API_KEY=

# IA agentic FastAPI / Gemini (SPEC_AI_GEMINI_GATEWAY)
# Preferible: .secrets/gemini.env (GOOGLE_API_KEY=...)
# AI_PROVIDER=gemini
# GOOGLE_API_KEY=
# AI_GEMINI_MODEL_LIST=gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-preview,gemini-3.6-flash-preview
# AI_GEMINI_MODEL_LIST_LITE=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Listas por agente (fallback ordenado): backend/app/config.py → GEMINI_PURPOSE_MODEL_DEFAULTS
# Límites capturados proyecto kidepik: .cursor/operations/GEMINI_API_FREE_TIER_LIMITS_KIDEPIK.md
# JOURNEY_DATA_DIR=/data/journey
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=  # opcional legacy; preferible editar tabla ai_purpose_model_queues
# AI_MODEL_PREFERENCE_QUALITY=...  # semilla si la tabla BD está vacía para ese purpose
# AI_MODEL_PREFERENCE_JOURNEY=...
# AI_MODEL_PREFERENCE_PLACEMENT=...
# Colas canónicas por purpose: Postgres public.ai_purpose_model_queues (sin redeploy)
# AI_HTTP_REFERER=http://localhost:8082
# AI_APP_TITLE=KidepiK Local
# AI_MAX_TOKENS_PER_TURN=1024
# AI_RATE_LIMIT_PER_CHILD_DAY=80
# Máximas producto (IA): Gemini vía Pydantic AI; sin AI_MOCK en runtime.
# AI_ALLOW_PAID ignorado en código. Tests PHPUnit inyectan AiGateway con chatFn.
# AI_DISCOVERY_REBUILD_TOP=15
# AI_QUEUE_REFRESH_MIN_MINUTES=5
# AI_GATEWAY_WALL_BUDGET_SECONDS=90
# AI_COMPOSE_BATCH_MAX_SLOTS=4
# AI_COMPOSE_BATCH_CONCURRENCY=3
# AI_COMPOSE_BATCH_RETRIES=2
# AI_COMPOSE_STICKY_WINNER=true
# AI_SUCCESS_BOOST_HOURS=48
# AI_COOLDOWN_TRANSPORT_HOURS=6
# AI_COOLDOWN_NOT_FOUND_HOURS=24
# AI_COOLDOWN_RATE_LIMIT_HOURS=2
# AI_COOLDOWN_EMPTY_HOURS=4
# AI_COOLDOWN_HTTP_HOURS=6
# AI_DISCOVERY_SYNC=true
# AI_DISCOVERY_INTERVAL_HOURS=6
# AI_DISCOVERY_MAX_NEW_PER_PURPOSE=5
# AI_DISCOVERY_ON_START=true

# Migraciones en local:
# - Supabase CLI: poc-up.ps1 ejecuta db reset / migration up
# - Contenedor PHP: entrypoint aplica pendientes al arrancar (RUN_MIGRATIONS_ON_START, default en local)
# - Por request: desactivado en APP_ENV=local (Config::runMigrationsOnRequest). Producción: activo con caché filesystem.
# RUN_MIGRATIONS_ON_REQUEST=true
# RUN_MIGRATIONS_ON_START=false

# Logs en disco (local POC → web/logs/, visible en Cursor)
# LOG_DIR=/var/www/html/logs
# LOG_LEVEL=info
# LOG_TO_FILES=true
# APP_DEBUG_AI=true  # umbral debug en canales api/ai/compose/client
# Permisos debug: grupos developers/admins en DB (SPEC_APP_DEBUG_MODE §1.4)
#   docker exec kidepik-poc-api-1 python -m app.scripts.grant_parent_group --email tutor@example.com --group developers
# Seed fundador: edusernalonso@gmail.com (migración 20260818170000_debug_developer_bootstrap_emails.sql)
# LOG_CLIENT_INGEST=true  # POST /api/v1/client/logs desde el front
