# OpenRouter — plantilla (copiar a kidepik/.secrets/openrouter.env)
# Producción: otra clave en el entorno del servidor; NUNCA versionar claves reales.
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Lista coma-separada opcional: solo sesga el ranking si quieres forzar orden manual.
# Sin esto, el gateway descubre modelos free en OpenRouter y los ordena por ranking interno.
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-30b-a3b:free
# Overrides finos opcionales (misma semilla, no obligatorios):
# AI_MODEL_PREFERENCE_QUALITY=...
# AI_MODEL_PREFERENCE_JOURNEY=...
# AI_MODEL_PREFERENCE_PLACEMENT=...
