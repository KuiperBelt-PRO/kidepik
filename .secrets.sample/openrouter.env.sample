# OpenRouter — plantilla (copiar a kidepik/.secrets/openrouter.env)
# Producción: otra clave en el entorno del servidor; NUNCA versionar claves reales.
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Lista coma-separada; fallback en orden (404/429 → siguiente).
# Revisar catálogo free: https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-30b-a3b:free
