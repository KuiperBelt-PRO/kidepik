# Copiar a kidepik/.secrets/oci.env y rellenar.
# Rutas relativas al repo se resuelven en runtime; en Windows puedes usar absolutas.

KIDEPIK_REPO=C:\path\to\kidepik

OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaa...
OCI_USER_OCID=ocid1.user.oc1..aaaa...
OCI_FINGERPRINT=aa:bb:cc:dd:...
OCI_REGION=eu-madrid-1
OCI_NAMESPACE=your-object-storage-namespace

OCI_CONFIG_FILE=.secrets/oci.config
OCI_KEY_FILE=.secrets/oracle_private.pem
OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaa...

OCI_SSH_PRIVATE_KEY_FILE=.secrets/ssh/kidepik_oci
OCI_SSH_PUBLIC_KEY_FILE=.secrets/ssh/kidepik_oci.pub
