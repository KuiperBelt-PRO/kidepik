# Plantilla — copiar a supabase/.env (gitignored) antes de `supabase start`
# Valores desde kidepik/.secrets/gcp-oauth.env
# URLs OAuth: scripts/sync-lan-auth.ps1 (KIDEPIK_LAN_HOST en .env.poc)

GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET
SUPABASE_API_EXTERNAL_URL=http://127.0.0.1:54321
SUPABASE_GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/auth/v1/callback
